# Spotify Developer App credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Obtained via `npm run get-token` (see README)
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# The ID of the Spotify playlist you want to manage (must be owned by you)
# Extract from the playlist URL: https://open.spotify.com/playlist/PLAYLIST_ID_HERE
SPOTIFY_PLAYLIST_ID=your_playlist_id_here
